# Branch demo/vercel: API data contoh dijalankan di peramban (mock/api.mjs),
# tanpa backend Go dan tanpa `npm run mock`. Lihat README → "Menjalankan tanpa backend".
#
# Untuk memakai server mock atau backend, timpa di .env.local:
#   NEXT_PUBLIC_MOCK_API=0
#   NEXT_PUBLIC_API_URL=http://localhost:8001/api
NEXT_PUBLIC_DEMO=1
NEXT_PUBLIC_MOCK_API=1
